  {
    "name": "set_pose",
    "kind": "edit",
    "description": "Set the current (unkeyed) pose value of a bone or object. Lost on frame change unless keyed;\n    use key_pose or set_keys to keep it.",
    "input_schema": {
      "type": "object",
      "properties": {
        "object": {
          "type": "string",
          "description": "Object name (usually the armature). Its assigned Action is edited."
        },
        "bone": {
          "type": "string",
          "description": "Pose bone name. Omit for object-level channels."
        },
        "channel": {
          "type": "string",
          "description": "location | rotation_quaternion | rotation_euler | rotation_axis_angle | scale | rotation_mode | [\"custom_prop\"]"
        },
        "value": {
          "description": "number, list of numbers, or rotation mode string"
        },
        "index": {
          "type": "integer",
          "description": "Set a single component only."
        }
      },
      "required": [
        "object",
        "channel",
        "value"
      ]
    }
  },
  {
    "name": "key_pose",
    "kind": "edit",
    "description": "Keyframe the bones' current pose values (like pressing I) at `frame`.",
    "input_schema": {
      "type": "object",
      "properties": {
        "object": {
          "type": "string",
          "description": "Object name (usually the armature). Its assigned Action is edited."
        },
        "bones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "default: location, rotation (current rotation mode), scale"
        },
        "frame": {
          "type": "number",
          "description": "default: current frame"
        }
      },
      "required": [
        "object",
        "bones"
      ]
    }
  },
