[
  {
    "name": "set_keys",
    "kind": "edit",
    "description": "Insert or update keyframes on one channel (creates the channel if needed).\n    Updating a key's value without giving handles moves its handles with it.",
    "input_schema": {
      "type": "object",
      "properties": {
        "object": {
          "type": "string",
          "description": "Object name (usually the armature). Its assigned Action is edited."
        },
        "action": {
          "type": "string",
          "description": "Action name; use instead of `object` for an unassigned Action."
        },
        "bone": {
          "type": "string",
          "description": "Pose bone name. Omit for object-level channels."
        },
        "channel": {
          "type": "string",
          "description": "location | rotation_euler | rotation_quaternion | rotation_axis_angle | scale, or a custom property written as [\"name\"] (e.g. [\"ik_fk\"])."
        },
        "index": {
          "type": "integer",
          "description": "Component index (x=0,y=1,z=2; quaternion w=0,x=1,y=2,z=3). Custom properties use 0.",
          "default": 0
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One keyframe. Only `frame` is required for existing keys; new keys also need `value`. Omitted fields keep their current value (new keys: Blender defaults). Values are raw channel units: radians for rotations.",
            "properties": {
              "frame": {
                "type": "number"
              },
              "value": {
                "type": "number"
              },
              "interp": {
                "type": "string",
                "enum": [
                  "CONSTANT",
                  "LINEAR",
                  "BEZIER",
                  "SINE",
                  "QUAD",
                  "CUBIC",
                  "QUART",
                  "QUINT",
                  "EXPO",
                  "CIRC",
                  "BACK",
                  "BOUNCE",
                  "ELASTIC"
                ]
              },
              "hl": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "left handle [frame, value]"
              },
              "hr": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "right handle [frame, value]"
              },
              "hlt": {
                "type": "string",
                "enum": [
                  "FREE",
                  "ALIGNED",
                  "VECTOR",
                  "AUTO",
                  "AUTO_CLAMPED"
                ]
              },
              "hrt": {
                "type": "string",
                "enum": [
                  "FREE",
                  "ALIGNED",
                  "VECTOR",
                  "AUTO",
                  "AUTO_CLAMPED"
                ]
              },
              "easing": {
                "type": "string",
                "enum": [
                  "AUTO",
                  "EASE_IN",
                  "EASE_OUT",
                  "EASE_IN_OUT"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "KEYFRAME",
                  "BREAKDOWN",
                  "MOVING_HOLD",
                  "EXTREME",
                  "JITTER",
                  "GENERATED"
                ]
              },
              "amp": {
                "type": "number"
              },
              "back": {
                "type": "number"
              },
              "period": {
                "type": "number"
              }
            },
            "required": [
              "frame"
            ]
          }
        },
        "group": {
          "type": "string",
          "description": "Channel group when the channel is created (default: bone name)."
        },
        "recalc_handles": {
          "type": "boolean",
          "default": true,
          "description": "Recalculate automatic handles afterwards (what Blender does after an edit)."
        }
      },
      "required": [
        "channel",
        "keys"
      ]
    }
  },
  {
    "name": "delete_keys",
    "kind": "edit",
    "description": "Delete keyframes on one channel by frame list or inclusive range.",
    "input_schema": {
      "type": "object",
      "properties": {
        "object": {
          "type": "string",
          "description": "Object name (usually the armature). Its assigned Action is edited."
        },
        "action": {
          "type": "string",
          "description": "Action name; use instead of `object` for an unassigned Action."
        },
        "bone": {
          "type": "string",
          "description": "Pose bone name. Omit for object-level channels."
        },
        "channel": {
          "type": "string",
          "description": "location | rotation_euler | rotation_quaternion | rotation_axis_angle | scale, or a custom property written as [\"name\"] (e.g. [\"ik_fk\"])."
        },
        "index": {
          "type": "integer",
          "description": "Component index (x=0,y=1,z=2; quaternion w=0,x=1,y=2,z=3). Custom properties use 0.",
          "default": 0
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Explicit frame numbers."
        },
        "frame_range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Inclusive [start, end] frame range."
        },
        "recalc_handles": {
          "type": "boolean",
          "default": true,
          "description": "Recalculate automatic handles afterwards (what Blender does after an edit)."
        },
        "remove_empty_channel": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "channel"
      ]
    }
  },
