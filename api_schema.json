  {
    "name": "detect_issues",
    "kind": "observe",
    "description": "Find common motion problems: foot sliding, jitter, euler/quaternion flips, pops, ground penetration.\n    Thresholds are in scene units; tune them for the character's scale.",
    "input_schema": {
      "type": "object",
      "properties": {
        "object": {
          "type": "string",
          "description": "Object name (usually the armature). Its assigned Action is edited."
        },
        "frame_range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Inclusive [start, end] frame range."
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "foot_sliding",
              "jitter",
              "rotation_flip",
              "pop",
              "below_ground"
            ]
          },
          "description": "default: all that apply"
        },
        "bones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "bones for jitter/flip/pop checks (default: all animated / all deform bones)"
        },
        "feet": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "default: guessed from names"
        },
        "ground_z": {
          "type": "number",
          "description": "ground height; default: lowest foot point in range"
        },
        "contact_height": {
          "type": "number",
          "default": 0.03
        },
        "slide_speed": {
          "type": "number",
          "default": 0.004,
          "description": "units per frame while in contact"
        },
        "jitter_rot": {
          "type": "number",
          "default": 0.05,
          "description": "rad/frame^2"
        },
        "jitter_loc": {
          "type": "number",
          "default": 0.01,
          "description": "units/frame^2"
        },
        "flip_threshold": {
          "type": "number",
          "default": 2.5,
          "description": "rad jump between frames"
        },
        "pop_factor": {
          "type": "number",
          "default": 6.0
        },
        "pop_min": {
          "type": "number",
          "default": 0.05
        },
        "max_issues": {
          "type": "integer",
          "default": 30
        }
      },
      "required": [
        "object"
      ]
    }
  }
]